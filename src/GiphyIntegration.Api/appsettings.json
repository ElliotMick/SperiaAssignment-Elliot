{
  "ConnectionStrings": {
    "GifCache": "Data Source=gifcache.db"
  },
  "Giphy": {
    "BaseUrl": "https://api.giphy.com/v1/",
    // Never commit the key: use `dotnet user-secrets set "Giphy:ApiKey" "<key>"` or the Giphy__ApiKey environment variable.
    "ApiKey": "",
    "Limit": 25,
    "Rating": "g",
    "Language": "en",
    "TimeoutSeconds": 10
  },
  "Trending": {
    "RefreshInterval": "01:00:00"
  },
  "SearchCache": {
    "MaxSearchesPerUser": 10,
    "PurgeInterval": "00:10:00",
    "UnreferencedRetention": "00:10:00"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      // Outgoing request URLs contain the Giphy API key: keep them out of the logs.
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
